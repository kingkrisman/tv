# Copy to .env.local (git-ignored) and fill in. Restart the server after editing.
#
# Region-locked channels: the stream relay can fetch them through a proxy in
# the right country. Supports http://, https:// and socks5:// URLs; most VPN
# providers offer SOCKS5 or HTTP proxy endpoints with your account credentials.

# Used for every relayed stream that has no country-specific proxy below.
# STREAM_PROXY=socks5://username:password@proxy.example.com:1080

# Per-country proxies, keyed by ISO country code. These win over STREAM_PROXY.
# STREAM_PROXY_US=http://username:password@us.proxy.example.com:8080
# STREAM_PROXY_GB=socks5://username:password@uk.proxy.example.com:1080
# STREAM_PROXY_CA=socks5://username:password@ca.proxy.example.com:1080
